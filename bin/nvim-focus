#!/usr/bin/env bash
# Switch herdr to the pane running the nvim that nvim-mcp drives.
# When that nvim is not in a pane of this herdr workspace (or this is not a
# herdr pane), print a note and exit 0: there is nothing for herdr to switch.
# --dry-run prints the target pane and tab without focusing.
set -euo pipefail

fail() {
  echo "nvim-focus: $*" >&2
  exit 1
}

note() {
  echo "nvim-focus: $*; switch to it yourself"
  exit 0
}

dry_run=false
case "${1:-}" in
  "") ;;
  --dry-run) dry_run=true ;;
  *) fail "usage: nvim-focus [--dry-run]" ;;
esac

socket=$("$(dirname "$0")/nvim-mcp" --check 2>/dev/null) || fail "no nvim is listening for agents; run nvim-mcp --check"
[[ -n "${HERDR_WORKSPACE_ID:-}" && -n "${HERDR_SOCKET_PATH:-}" ]] || note "not running inside a herdr pane"
command -v herdr >/dev/null || fail "herdr is not on PATH"
command -v jq >/dev/null || fail "jq is not on PATH"

# herdr reports the nvim TUI process, the parent of the server behind the socket.
server_pid=$(nvim --server "$socket" --remote-expr 'getpid()' 2>/dev/null) || fail "could not query nvim on $socket"
owner_pids=("$server_pid" "$(ps -o ppid= -p "$server_pid" | tr -d ' ')")

panes=$(herdr pane list --workspace "$HERDR_WORKSPACE_ID") || fail "could not list herdr panes"
target_pane="" target_tab=""
while IFS=$'\t' read -r pane tab; do
  info=$(herdr pane process-info --pane "$pane" 2>/dev/null) || continue
  pids=$(jq -r '.result.process_info.foreground_processes[].pid' <<<"$info") || continue
  for pid in "${owner_pids[@]}"; do
    if grep -qx "$pid" <<<"$pids"; then
      target_pane=$pane target_tab=$tab
      break 2
    fi
  done
done < <(jq -r '.result.panes[] | [.pane_id, .tab_id] | @tsv' <<<"$panes")

[[ -n "$target_pane" ]] || note "nvim (pid $server_pid) is not in a pane of herdr workspace $HERDR_WORKSPACE_ID"

if $dry_run; then
  echo "$target_pane $target_tab"
  exit 0
fi

herdr tab focus "$target_tab" >/dev/null || fail "could not focus herdr tab $target_tab"
request=$(jq -cn --arg pane "$target_pane" '{id: "nvim-focus", method: "pane.focus", params: {pane_id: $pane}}')
response=$(printf '%s\n' "$request" | nc -U -w 2 "$HERDR_SOCKET_PATH") || fail "could not reach herdr socket $HERDR_SOCKET_PATH"
jq -e '.result' <<<"$response" >/dev/null || fail "herdr refused to focus pane $target_pane: $response"
echo "focused nvim pane $target_pane"
